# ============================================================
# ENVIRONMENT VARIABLES - STUDENT ATTENDANCE SYSTEM
# ============================================================
# WHAT IS THIS FILE?
# This file stores secret configuration values for your app.
# Never share this file or upload it to GitHub!
# Copy this file, rename it to ".env" and fill in YOUR values.
# ============================================================

# MongoDB Atlas Connection String
# HOW TO GET THIS:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create a free account
# 3. Create a new Cluster (free tier is fine)
# 4. Click "Connect" → "Connect your application"
# 5. Copy the connection string and replace <password> with your DB password
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/student_attendance?retryWrites=true&w=majority

# JWT Secret Key
# This is a random secret string used to sign/verify login tokens.
# Make it long and random. You can type any random characters here.
# Example: JWT_SECRET=myRandomSuperSecretKey12345abcXYZ
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Token Expiry - how long login sessions last
JWT_EXPIRES_IN=7d

# Server Port - which port your backend runs on
PORT=5000

# Admin Credentials (for the admin panel)
# Change these to something secure!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_SECRET_KEY=your_admin_secret_key_here
